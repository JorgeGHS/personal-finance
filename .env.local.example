# Contraseña para entrar al dashboard
DASHBOARD_PASSWORD=cambia-esto

# Cadena aleatoria larga, usada para firmar la cookie de sesión.
# Genera una con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-tambien

# Clave gratuita de https://twelvedata.com (plan free: 800 peticiones/dia)
# Se usa para precios de acciones/ETFs (VUAA, NQSE, IUSA, ORCL, META, RIVN, ONON, RGTI...)
TWELVE_DATA_API_KEY=

